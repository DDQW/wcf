# --- Pflicht ---------------------------------------------------------------
DATABASE_URL=postgres://postgres:dev@localhost:5432/woelki_dev
LEPTOS_SITE_ADDR=127.0.0.1:3000

# --- Allgemein -------------------------------------------------------------
# Öffentliche Basis-URL (für Links in E-Mails und Feeds)
#PUBLIC_URL=https://community.example.org
# Ablage für Uploads, Thumbnails, Medien
#DATA_DIR=data
# Hinter HTTPS auf true setzen
#COOKIE_SECURE=false
# Nur hinter einem Reverse-Proxy: X-Forwarded-For vertrauen
#TRUST_PROXY=false
# Log-Level
#RUST_LOG=info

# --- E-Mail (optional, für Passwort-Reset) ---------------------------------
#SMTP_HOST=smtp.example.org
#SMTP_PORT=587
#SMTP_TLS=starttls   # starttls | tls | none
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM=Community <community@example.org>

# --- Video-/Audiocalls über LiveKit (optional) ------------------------------
#LIVEKIT_URL=ws://127.0.0.1:7880
#LIVEKIT_API_KEY=devkey
#LIVEKIT_API_SECRET=secret

# --- Medien (optional) ------------------------------------------------------
# ffmpeg/ffprobe für Video-Vorschaubilder und die Kino-Mediathek. Ohne Angabe
# wird PATH durchsucht (unter Windows zusätzlich winget-Installationen).
#FFMPEG_PATH=ffmpeg

# --- Kino / Watch together (optional) --------------------------------------
# Ordner, dessen Videodateien die Mediathek zum Import anbietet
# (Standard: DATA_DIR/watch/incoming). Verknüpfte Bibliotheken werden verfolgt.
#WATCH_IMPORT_DIR=/srv/filme
# Obergrenze für verpackte HLS-Medien in GB (Direct Play belegt keinen Platz).
#WATCH_MAX_MEDIA_GB=200
